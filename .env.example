# Frontend build-time config (safe to be public — these are the Supabase
# project ref and anon key, not secrets). Copy to .env.local for local
# overrides, or set as environment variables in your Netlify site settings.
VITE_SUPABASE_PROJECT_ID=kknhbddqipxbtffwyfbe
VITE_SUPABASE_ANON_KEY=

# --- Backend (Supabase Edge Function) secrets ---
# These are NOT read from this file — they must be set via the Supabase CLI
# or Dashboard, since the edge function runs outside this Vite app:
#
#   supabase secrets set GOOGLE_SERVICE_ACCOUNT_JSON='<service-account-json>' \
#     --project-ref kknhbddqipxbtffwyfbe
#   supabase secrets set ALLOWED_ORIGINS='https://your-site.netlify.app' \
#     --project-ref kknhbddqipxbtffwyfbe
#   supabase secrets set CLEANUP_SECRET='<random-string>' \
#     --project-ref kknhbddqipxbtffwyfbe
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by the
# Supabase Edge Function runtime and don't need to be set manually.
